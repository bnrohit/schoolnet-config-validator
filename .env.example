# SchoolNet Config Validator environment
APP_ENV=production
API_PORT=8000
WEB_PORT=3002

# Production frontend uses the same-origin Nginx proxy.
VITE_API_URL=.
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Live SSH is optional and disabled by default. Enable only on a trusted internal
# network, behind HTTPS, using least-privilege/read-only credentials.
ENABLE_LIVE_SSH=false

# Network Incident Investigator can always troubleshoot private/loopback/link-local
# targets. Public targets are blocked unless explicitly enabled for authorized use.
ALLOW_PUBLIC_DIAGNOSTICS=false

MAX_UPLOAD_SIZE_MB=2
