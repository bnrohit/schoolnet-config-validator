# SchoolNet Config Validator environment
APP_ENV=production
API_PORT=8000
WEB_PORT=3002

# Production frontend uses the same-origin Nginx proxy.
VITE_API_URL=.
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Optional enterprise/default DNS resolver used when the operator leaves the
# resolver field blank. Leave empty to use the container/system resolver.
DEFAULT_DNS_SERVER=

# Deep Network Engineer automatically checks HTTP/HTTPS assurance on 80/443
# in addition to explicitly requested web ports. Still bounded to one target.
AUTO_APPLICATION_PROBE=true

# Live SSH is optional and disabled by default. Enable only on a trusted internal
# network, behind HTTPS, using least-privilege/read-only credentials.
ENABLE_LIVE_SSH=false
REQUIRE_HTTPS_FOR_LIVE_CREDENTIALS=true

# Emergency compatibility escape hatch. Keep false in production.
ALLOW_INSECURE_LIVE_CREDENTIALS=false

# Network Incident Investigator can always troubleshoot private/loopback/link-local
# targets. Public targets are blocked unless explicitly enabled for authorized use.
ALLOW_PUBLIC_DIAGNOSTICS=false

# Opt-in diagnostic history. Stored payloads contain troubleshooting evidence but
# never request credentials. Enable only where retaining operational evidence is acceptable.
ENABLE_DIAGNOSTIC_HISTORY=false
DIAGNOSTIC_HISTORY_DB=/data/diagnostic_history.sqlite3
DIAGNOSTIC_HISTORY_RETENTION=100

MAX_UPLOAD_SIZE_MB=2
