# SchoolNet Config Validator environment
APP_ENV=production
API_PORT=8000
WEB_PORT=3002

# Production frontend uses the same-origin Nginx proxy.
VITE_API_URL=.
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Keep live SSH disabled until you are on a trusted internal network.
ENABLE_LIVE_SSH=false
MAX_UPLOAD_SIZE_MB=2
